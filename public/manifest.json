{
  "manifest_version": 3,
  "name": "Feather",
  "version": "2.3.0",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bing.com/*"
      ],
      "js": ["scripts/cors.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "alarms", "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.bing.com/*",
    "*://bing.com/*"
  ]
}